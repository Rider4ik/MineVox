
{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_STANDARD_REQUIRED": true,
                "CMAKE_CXX_EXTENSIONS": false,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },

        {
            "name": "clang",
            "displayName": "Clang",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clang"
        },
        {
            "name": "gcc",
            "displayName": "GCC",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/gcc",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "msvc",
            "displayName": "MSVC",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/msvc"
        },
        {
            "name": "mingw",
            "displayName": "MinGW GCC",
            "inherits": "base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/mingw",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },

        {
            "name": "clang-14",
            "inherits": "clang",
